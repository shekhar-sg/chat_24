    "@mui/icons-material": "^7.1.0",
    "@mui/lab": "^7.0.0-beta.12",
    "@mui/material": "^7.1.0",
    "@mui/material-nextjs": "^7.1.0",
    "@reduxjs/toolkit": "^2.8.2",
    "cloudinary": "^2.11.0",
    "emoji-picker-react": "^4.12.2",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "js-cookie": "^3.0.5",
