{
  "name": "beyond-chats-assignment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --require ./tests/register.cjs --test tests/unit/*.test.cjs",
