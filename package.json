    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-beyond-chat \"node tests/e2e.cjs\"",
    "check:env": "node scripts/check-env.cjs",
    "check:services": "node scripts/check-services.cjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
